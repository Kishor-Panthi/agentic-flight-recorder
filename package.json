{
  "name": "agentic-flight-recorder",
  "version": "0.1.0",
  "description": "Universal observability for AI agents. See what your agents are doing, why, and at what cost.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "afr": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "dev:dashboard": "cd dashboard && npm run dev",
